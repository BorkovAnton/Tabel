# База данных (внутри docker-сети)
DATABASE_URL=postgresql://user:password@postgres:5432/tabel
SECRET_KEY=your--secret-key

# Фронтенд: вшивается в сборку! После изменения пересобрать frontend
# dev: http://localhost:8000   prod: http://192.168.100.231:8000
VUE_APP_API_URL=http://localhost:8000
VUE_APP_WS_URL=ws://localhost:8000/ws

# CORS бэкенда: origins, с которых открыт фронтенд (через запятую)
# dev: http://localhost,http://127.0.0.1   prod: http://192.168.100.231
CORS_ORIGINS=http://localhost,http://127.0.0.1